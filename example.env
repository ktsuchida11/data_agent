# cp example.env .env して値を入れる。.env はエージェントのファイルツールから見えない場所にある。

# Anthropic API キー
ANTHROPIC_API_KEY=

# モデル（省略時: メイン claude-opus-5-5 / 軽量 claude-haiku-5-5）
# 費用を抑えるなら MAIN_MODEL=claude-sonnet-5-5
MAIN_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
MAIN_EFFORT=high
# 画面の設定欄で選べるモデル（カンマ区切り）。新しいチャットは MAIN_MODEL で始まる
# 例: Fable 5.2 も選べるようにするなら、先頭に claude-fable-5-2 を足す（料金は Opus より高い）
MODEL_CHOICES=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# 安全分類器に断られたときにサーバー側で別モデルに切り替える（Opus 5.5 / Sonnet 5.5 のみ有効）
ENABLE_REFUSAL_FALLBACK=true

# Chainlit のログイン
# CHAINLIT_AUTH_SECRET は `uv run chainlit create-secret` で作る
CHAINLIT_AUTH_SECRET=
APP_USERNAME=admin
# パスワードの SHA-256: uv run python -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
APP_PASSWORD_SHA256=

# 会話の保存先（PostgreSQL）。DB_HOST を設定しなければメモリ上に保存し、再起動で消える。
# 手元では Langfuse と同じ PostgreSQL を使う。`bash scripts/setup_local_db.sh` を実行すると、
# データベースとロールを作り、下の5項目を .env に追記する（手で書く必要はない）。
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=coding_agent
# DB_USER=coding_agent
# DB_PASSWORD=
# AWS の RDS では DB_SSLMODE=require にする（省略時は prefer）

# エージェントがデータを読みに行くデータベース（PostgreSQL。任意）。DATA_DB_HOST を設定しなければ、
# データベースのツールは付かない。読み取りだけを許したロールでつなぐこと（管理者のロールでは受け付けない）。
# 手元の Langfuse と同じ PostgreSQL にあるデータベースなら、`bash scripts/setup_data_db.sh <データベース名>` を
# 実行すると、読み取り専用のロールを作り、下の項目を .env に追記する（手で書く必要はない）。
# 練習用のデータで試すなら `bash scripts/setup_data_db.sh --sample`。
# 個人情報の列は、config/hidden_columns.<データベース名>.txt に書くと、エージェントから読めなくなる。
# 下書きは `bash scripts/setup_data_db.sh --columns <データベース名>` が作る。
# DATA_DB_HOST=127.0.0.1
# DATA_DB_PORT=5432
# DATA_DB_NAME=
# DATA_DB_USER=coding_agent_reader
# DATA_DB_PASSWORD=
# AWS の RDS では DATA_DB_SSLMODE=require にする（省略時は prefer）
# コンテナ（docker compose）からは別の名前でつなぐとき（手元の PostgreSQL のコンテナなど）だけ書く
# DATA_DB_DOCKER_HOST=postgres
# DATA_DB_DOCKER_PORT=5432
# Web 検索の前の確認で、顧客の名前などの列を「見張る言葉」として読むロール（任意。ADR-0022）。
# エージェントのロールとは別にする。つなぐ先は DATA_DB_HOST と同じ。config/watch_columns.<データベース名>.txt に
# 列を書いて `bash scripts/setup_data_db.sh <データベース名>` を実行すると、ロールを作り、下の項目を追記する。
# DATA_DB_SCREENER_USER=coding_agent_screener
# DATA_DB_SCREENER_PASSWORD=

# Web 検索に使うモデル（省略時は claude-sonnet-5-5）。検索して要点をまとめる役で、チャットのモデルとは別に呼び出す。
# 検索は 1,000 回あたり 10 ドルと、このモデルの利用料がかかる。止めるときは config/security.yaml の web_search.enabled を false に
# WEB_SEARCH_MODEL=claude-sonnet-5-5

# 定時実行（会話を PostgreSQL に保存しているときだけ使える）。省略時は下の値になる
# SCHEDULE_TIMEZONE=Asia/Tokyo   # 予定の時刻を、どのタイムゾーンで解釈するか
# SCHEDULER_ENABLED=true         # アプリの中で時刻を見て実行する。外から起動する構成では false
# SCHEDULER_POLL_SECONDS=30      # 時刻が来た予定がないかを見る間隔（秒）

# Langfuse へのトレースの送信（任意）。2つの鍵を設定したときだけ送る。
# 鍵は、Langfuse の画面でプロジェクトを作り、Settings → API Keys で作る。
# 送る内容は、ガードレールでマスクしてから送る。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# `uv run` で動かすときの送信先。コンテナで動かすときは、compose.yaml が上書きする
# LANGFUSE_BASE_URL=http://localhost:3000
